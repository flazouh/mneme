# Copy to ~/.config/mneme/config.env

# MNEME_DATA_DIR="$HOME/.local/share/mneme"
# MNEME_ARCHIVE_REPO="$HOME/Documents/Codex/personal-memory-archive"
# MNEME_ARCHIVE_PUSH=false
# MNEME_HASH_EMBED=false

# OpenRouter is OpenAI-compatible.
# OPENAI_API_KEY=
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# MNEME_EMBEDDING_MODEL="openai/text-embedding-3-small"
